# Flask 應用配置
# 複製此文件為 .env 並填入正確的值
# 重要提示：.env 文件包含敏感資訊，不應提交到版本控制系統

# ========== 資料庫配置 ==========
# SQL Server 連接資訊
SQLALCHEMY_DATABASE_URI=DATABSE_URL

# ========== Flask 應用配置 ==========
# 安全密鑰（用於加密會話）
SECRET_KEY=generate_a_strong_random_key  # 可使用 os.urandom(24).hex() 生成

# Amadeus API Credentials
AMADEUS_API_KEY=AMADEUS_KEY
AMADEUS_API_SECRET=AMADEUS_SECRET

# ========== LINE Bot 配置 ==========
LINE_CHANNEL_SECRET=LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=LINE_CHANNEL_ACCESS_TOKEN

# ========== 緩存配置 ==========
CACHE_TYPE=SimpleCache # 緩存類型 (SimpleCache 或 RedisCache)
CACHE_DEFAULT_TIMEOUT=300 # 默認超時時間 (秒)
CACHE_REDIS_URL= # 如果 CACHE_TYPE=RedisCache，請填入 Redis 連接 URL (例如 redis://localhost:6379/0)