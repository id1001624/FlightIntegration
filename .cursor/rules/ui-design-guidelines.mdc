    <div class="flex-1 flex items-center justify-center px-4">
      <div class="w-full h-px bg-gray-300 relative">
        <span class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 text-xs text-gray-500">2h 15m</span>
      </div>
    </div>
    
    <div class="text-center">
      <p class="text-xl font-semibold">16:45</p>
